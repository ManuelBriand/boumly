rules_version = '2';

// ───────────────────────────────────────────────────────────────────
// Boumly — règles Storage de production
//
// Arborescence (cf. storage.service.ts) :
//   products/{userId}/{fichier}   images produits
//   stores/{userId}/{fichier}     photo de boutique
//   events/{userId}/{fichier}     photo d'événement (organisateur)
//
// Lecture publique (images affichées sur la vitrine).
// Écriture réservée au propriétaire (userId == uid), images uniquement,
// taille plafonnée.
// ───────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Upload : image matricielle < 5 Mo. Pas de SVG : il peut embarquer du script.
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif|heic|heif)');
    }

    match /products/{userId}/{fileName} {
      allow read:         if true;
      allow create, update: if isUser(userId) && validImage();
      allow delete:       if isUser(userId);
    }

    match /stores/{userId}/{fileName} {
      allow read:         if true;
      allow create, update: if isUser(userId) && validImage();
      allow delete:       if isUser(userId);
    }

    match /events/{userId}/{fileName} {
      allow read:         if true;
      allow create, update: if isUser(userId) && validImage();
      allow delete:       if isUser(userId);
    }

    match /prestations/{userId}/{fileName} {
      allow read:         if true;
      allow create, update: if isUser(userId) && validImage();
      allow delete:       if isUser(userId);
    }

    // Refus par défaut
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
