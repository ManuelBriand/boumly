# ── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (client, config web publique) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (serveur uniquement) ────────────────────────────
# JSON du service account encodé en base64 : base64 -i service-account.json
FIREBASE_ADMIN_SA=

# ── Stripe ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# En local : npm run stripe:webhook affiche le secret whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Commissions de la plateforme, en % (défauts : 10 / 8 / commande)
STRIPE_PLATFORM_FEE_PCT=10
STRIPE_REGISTRATION_FEE_PCT=8
STRIPE_BOOKING_FEE_PCT=10

# ── E-mails transactionnels (Mailjet) ──────────────────────────────
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Boumly
# Destinataire du formulaire de contact (défaut : MAILJET_FROM_EMAIL)
CONTACT_EMAIL=

# ── Mapbox (autocomplétion d'adresse) ──────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
